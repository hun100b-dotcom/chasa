{"spots":[{"id":"R2-01","act":2,"time":1,"x":110,"z":862,"place":"아랫마을 마당","speakers":["빨래하는 아낙","그 동무"],"lines":["이장 어른 가시고는 관아 서찰 읽어 줄 사람이 없어.","읽어 봐야 숫자뿐이라던데."],"half":"이장 어른 가시고는…","echo":"마을 이장"},{"id":"R2-02","act":2,"time":2,"x":115,"z":858,"place":"아랫마을 우물","speakers":["석수 제자","물 긷는 노인"],"lines":["성돌 밑에서 썩은 목패가 또 나왔어요.","도로 묻어라. 읽지 말고."],"half":"성돌 밑에서…","echo":"석수 판돌"},{"id":"R2-03","act":2,"time":2,"x":125,"z":840,"place":"벌초꾼 집","speakers":["벌초꾼 아들","그 어미"],"lines":["큰 무덤은 아무리 베도 어디가 끝인지 모르겠어요.","그러니 다 베라. 다 누구 자리다."],"half":"큰 무덤은 아무리 베도…","echo":"벌초꾼 만석"},{"id":"R2-04","act":2,"time":1,"x":215,"z":920,"place":"화살골 어귀","speakers":["약초 캐는 이웃","그 딸"],"lines":["바위틈엔 손 넣지 마. 녹슨 촉에 벤다.","분녀 아지매는 맨손으로도 잘 캤는데."],"half":"바위틈엔 손 넣지…","echo":"약초 아낙 분녀"},{"id":"R2-05","act":2,"time":1,"x":118,"z":962,"place":"산성 문","speakers":["나무꾼","나무꾼 동무"],"lines":["해 지면 성안에서 수 세는 소리가 난대.","세다가 끊기는 게 더 무섭지."],"half":"해 지면 성안에서…","echo":"화살골 나무꾼"},{"id":"R2-06","act":2,"time":3,"x":104,"z":850,"place":"이장 집","speakers":["이장네 아들","이장네 안사람"],"lines":["아버님이 받아 둔 관아 명단, 태울까요.","두어라. 거기엔 태울 이름도 없다."],"half":"관아 명단, 태울까요…","echo":"마을 이장"},{"id":"R2-07","act":2,"time":1,"x":110,"z":812,"place":"아랫마을 남쪽 어귀","speakers":["지나가는 장꾼","장꾼 동무"],"lines":["건넛골 사람들도 그 골짜기에 묻혔다더구먼.","죽고 나면 이쪽 저쪽이 어디 있나."],"half":"건넛골 사람들도…","echo":"건너편 병사"},{"id":"R2-08","act":2,"time":1,"x":60,"z":1205,"place":"작은 무덤 떼","speakers":["무덤 돌보는 아낙","그 시누이"],"lines":["설이가 큰 무덤 굿을 하다 말았대.","부를 이름을 못 받아서 그랬다지."],"half":"설이가 큰 무덤 굿을…","echo":"무당 손녀 설이"},{"id":"R2-09","act":2,"time":0,"x":458,"z":805,"place":"광부촌 어귀","speakers":["교대 광부","교대 광부 동무"],"lines":["산신각에 막걸리 붓던 영감이 요새 안 보여.","그 양반 가고는 아무도 안 붓지."],"half":"산신각에 막걸리…","echo":"산신 모시던 광부"},{"id":"R2-10","act":2,"time":2,"x":462,"z":875,"place":"국밥집","speakers":["국밥집 아들","늙은 광부"],"lines":["외상은 번호 말고 이름으로 적어 주시오.","…이름이 뭐였더라. 다들 번호로만 불러서."],"half":"외상은 번호 말고…","echo":"국밥집 주인 장씨"},{"id":"R2-11","act":2,"time":1,"x":492,"z":842,"place":"노새 마구간","speakers":["마부","마부 동무"],"lines":["갑돌이 없으니 노새가 말을 안 들어.","제 이름 불러 주던 사람은 노새도 아는 게지."],"half":"갑돌이 없으니…","echo":"노새 몰이 갑돌"},{"id":"R2-12","act":2,"time":2,"x":470,"z":836,"place":"광부촌 우물가","speakers":["선탄장 아낙","다른 아낙"],"lines":["복례 딸이 어미 자리에 앉았더라.","손톱 까매지는 거 보면 속상해서 원."],"half":"복례 딸이…","echo":"선탄장 아낙 복례"},{"id":"R2-13","act":2,"time":1,"x":560,"z":980,"place":"갱 입구","speakers":["교대 광부","교대 광부 동무"],"lines":["버팀목 또 아끼래. 나무값이 비싸다고.","그 나무값보다 싼 게 누군데."],"half":"버팀목 또 아끼래…","echo":"갱도 목수"},{"id":"R2-14","act":2,"time":3,"x":445,"z":890,"place":"순돌 집","speakers":["순돌네 아이","순돌네 안사람"],"lines":["아버지 목패는 언제 돌려준대요?","떼어 온 사람이 있대. 내일 갖다준다더라."],"half":"아버지 목패는…","echo":"광부 순돌"},{"id":"R2-15","act":2,"time":1,"x":640,"z":1090,"place":"갱도 골 중간 버팀목","speakers":["목수 제자","짐꾼"],"lines":["이 버팀목, 목수 어른이 세운 거야. 아직 안 휘었어.","사람은 갔는데 나무는 버티네."],"half":"이 버팀목…","echo":"갱도 목수"},{"id":"R3-01","act":3,"time":2,"x":985,"z":470,"place":"갯골댁 집","speakers":["그물 아낙","옆집 아낙"],"lines":["갯골댁 그물은 아직 그 코 하나가 비었더라.","기우지 마. 그 집에서 그렇게 두랬어."],"half":"갯골댁 그물은…","echo":"갯골댁"},{"id":"R3-02","act":3,"time":1,"x":900,"z":300,"place":"소금 창고","speakers":["염전 일꾼","일꾼 동무"],"lines":["주인은 오늘도 우리를 판으로 세더라.","한 판 두 판… 그럼 우린 소금이냐."],"half":"주인은 오늘도…","echo":"소금밭 일꾼"},{"id":"R3-03","act":3,"time":3,"x":915,"z":305,"place":"덕보 집","speakers":["덕보네 안사람","덕보네 아들"],"lines":["아주버님은 끝내 안 올라오셨지.","소금이나 한 줌 바다에 뿌려 드려요."],"half":"아주버님은 끝내…","echo":"소금장수 덕보"},{"id":"R3-04","act":3,"time":2,"x":1070,"z":400,"place":"순덕 집","speakers":["순덕 어미","순덕 동생"],"lines":["혼례 옷은 장롱에 그대로 둬라.","배 오는 날 입는다고 했으니까요."],"half":"혼례 옷은 장롱에…","echo":"순덕"},{"id":"R3-05","act":3,"time":0,"x":1132,"z":452,"place":"등대지기 막","speakers":["선창 어부","어부 동무"],"lines":["등잔이 아침까지 켜져 있었대.","끄면 배가 길 잃는다고, 그 영감 버릇이지."],"half":"등잔이 아침까지…","echo":"등대지기"},{"id":"R3-06","act":3,"time":1,"x":880,"z":250,"place":"염전 둑","speakers":["소금 짓는 아낙","그 딸"],"lines":["소금 할미는 이름 적은 쪽지를 독에 묻었대.","썩지 말라고요? 할미다워."],"half":"소금 할미는…","echo":"소금 할미"},{"id":"R3-07","act":3,"time":1,"x":1110,"z":160,"place":"여울 북쪽 갯바위","spe